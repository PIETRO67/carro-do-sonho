# Origem pública do site comercial (sem path); deixe vazio em desenvolvimento.
NEXT_PUBLIC_SITE_URL=
# Prefixo adicional de hospedagem. Ex.: /institucional (exige rebuild).
APP_BASE_PATH=
NEXT_PUBLIC_APP_BASE_PATH=
# Endereços oficiais: não apontar o botão de acesso para uma cópia do ERP.
NEXT_PUBLIC_SYSTEM_URL=https://carrodosonho.com.br/admin
NEXT_PUBLIC_ACCOUNTANT_URL=https://carrodosonho.com.br/portal-contador
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
# Endpoint HTTPS privado. Deve responder 2xx apenas após aceitar o lead.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Serviço Redis REST compartilhado para rate limit de produção.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Segredo aleatório de no mínimo 32 caracteres para hash de IP.
RATE_LIMIT_SECRET=
# Ative somente após publicar a política de privacidade revisada.
LEAD_PRIVACY_APPROVED=false
